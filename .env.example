# Life Line — environment variables
# Copy to .env.local for development and set the same values in your host (e.g. Vercel).

# --- Supabase (required) -----------------------------------------------------
# Project URL and PUBLIC publishable/anon key. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- App URLs (required) -----------------------------------------------------
# Public site URL. Used for links and must match a Supabase Auth redirect URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Allowed origin for state-changing requests (CSRF guard). Set to your deployed origin in production.
CARE_APP_ORIGIN="http://localhost:3000"

# --- Admins ------------------------------------------------------------------
# Clients never authenticate; only admins do, at /admin/login (username + password).
# Five admin accounts (admin1..admin5) are seeded by the SQL migrations. The admin allowlist
# lives IN THE DATABASE (app_config.admin_email, comma-separated) — not here. Add the owner:
#   update public.app_config set value = value || ',owner@example.com' where key = 'admin_email';

# --- WhatsApp notifications (optional) ---------------------------------------
# The NotificationService is mock-first: without these, notifications are recorded as "mock"
# and the admin still gets a wa.me quick-message link. Provide a real provider's credentials
# to enable automated sending (a failure is logged as FAILED and never blocks the workflow).
# WHATSAPP_API_TOKEN="(server-only)"
# WHATSAPP_PHONE_ID="(server-only)"

# --- Not required by the app -------------------------------------------------
# The application never uses the Supabase service-role/secret key. Authorization is
# enforced by Row Level Security and SECURITY DEFINER RPCs. Keep the secret key out
# of the app; only use it for out-of-band admin/maintenance scripts if ever needed.
# SUPABASE_SERVICE_ROLE_KEY="(do not commit; server-only, optional)"

# Map tiles use public OpenStreetMap tiles and Nominatim reverse geocoding — no key needed.
